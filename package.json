{
  "name": "telegram-speech-to-text",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "pm2:start": "pm2 start src/index.ts --interpreter $HOME/.bun/bin/bun --name tg-stt",
    "pm2:logs": "pm2 logs tg-stt",
    "pm2:save": "pm2 save"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "grammy": "^1.42.0",
    "openai": "^6.37.0"
  }
}
