{
  "name": "voice-clip",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit && bun x vue-tsc --noEmit -p web && bun x tsc --noEmit -p core && bun x vue-tsc --noEmit -p tests/web"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitejs/plugin-vue": "^6",
    "typescript": "^5.9.3",
    "vite": "^8",
    "vue-tsc": "^3"
  },
  "dependencies": {
    "openai": "^6.37.0",
    "pinia": "^3",
    "vue": "^3.5.35"
  }
}
