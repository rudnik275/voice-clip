# voice-clip — runtime env. Copy to `.env` and fill in your values.
#   cp .env.example .env
#
# `.env` is gitignored AND blocked from AI reads (global CLAUDE.md rule), so
# values stay between you and docker-compose.

# ─── Required: OpenAI ──────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# (Tip: also already in 1Password vault VoiceClip / GPT_API_TOKEN — copy from there.)
OPENAI_API_KEY=

# ─── Required: admin gate for /admin/invites ───────────────────────────────
# Generate yourself in your own terminal:
#   openssl rand -hex 16
# Then paste the result here. After first deploy you can rotate any time —
# new ADMIN_TOKEN means you can't generate invites with the old one.
ADMIN_TOKEN=

# ─── Required after Phase 4 Tailscale Funnel: public origin ────────────────
# Format: https://<your-nas>.tail-XXXX.ts.net
# Leave empty for the very first deploy — server will start anyway. Once
# `scripts/setup-tailscale-funnel.sh` prints the URL, paste it here and
# re-run `./scripts/deploy.sh` so the daemon installer knows where to point.
PUBLIC_URL=

# ─── Required: NAS connection (used by deploy scripts only, not container) ─
# NAS_HOST: hostname or IP. If you have Tailscale on your laptop, the Tailscale
# magic-DNS name works (e.g. nas-rudnik.tail-XXXX.ts.net). Otherwise the LAN
# DNS name (typically <name>.local on Synology) or the static LAN IP.
NAS_HOST=
# NAS_USER: the DSM account used for SSH. Default `dimka` based on the 1Password
# item; change if you SSH as a different user.
NAS_USER=dimka
# REMOTE_DIR: where the project is rsync'd on the NAS. /volume1/docker/<name>
# is the Synology Container Manager convention.
REMOTE_DIR=/volume1/docker/voice-clip
