# voice-clip — runtime env. Copy to `.env` and fill in your values.
#   cp .env.example .env
#
# `.env` is gitignored AND blocked from AI reads (global CLAUDE.md rule), so
# values stay between you and docker-compose.

# ─── Required: OpenAI ──────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Required: Google OAuth ────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for the client: {PUBLIC_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Required: comma-separated email allowlist ─────────────────────────────
# Any Google account email NOT on this list will see "Access denied" and no
# session is created. Case-insensitive.
VOICE_CLIP_ALLOWED_EMAILS=you@example.com,partner@example.com

# ─── Required: public origin ───────────────────────────────────────────────
# Where the Cloudflare Tunnel terminates TLS. Used to build the OAuth
# redirect_uri — must EXACTLY match what's configured in the Google client.
PUBLIC_URL=https://voice.rudifamily.uk

# ─── Optional: server tuning ───────────────────────────────────────────────
# DATA_DIR defaults to /data inside the container (mounted from ./data on host).
# PORT defaults to 8080.
# DATA_DIR=/data
# PORT=8080
