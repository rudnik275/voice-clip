# voice-clip — runtime env. Copy to `.env` and fill in your values.
#   cp .env.example .env
#
# `.env` is gitignored AND blocked from AI reads (global CLAUDE.md rule), so
# values stay between you and docker-compose.

# ─── Required: OpenAI ──────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Required: Google OAuth ────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for the client: {PUBLIC_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Required: comma-separated email allowlist ─────────────────────────────
# Any Google account email NOT on this list will see "Access denied" and no
# session is created. Case-insensitive.
VOICE_CLIP_ALLOWED_EMAILS=you@example.com,partner@example.com

# ─── Optional: owner email ─────────────────────────────────────────────────
# Marks this email as the "owner" — they get is_owner=true on /me, see the
# "Generate invite link" button in the profile modal, and can POST to
# /admin/invites with just their session (no X-Admin-Token needed).
# OWNER_EMAIL=you@example.com

# ─── Optional: admin endpoints shared-secret ───────────────────────────────
# Shared-secret for /admin/* endpoints — invite generation and observability
# (errors list + replay). Lets ops scripts hit them via X-Admin-Token without
# a session cookie. Unset → admin routes return 401 unless the request has
# an OWNER_EMAIL session.
# Generate one with: openssl rand -hex 24
# ADMIN_TOKEN=

# ─── Required: public origin ───────────────────────────────────────────────
# Where the Cloudflare Tunnel terminates TLS. Used to build the OAuth
# redirect_uri — must EXACTLY match what's configured in the Google client.
PUBLIC_URL=https://voice.rudifamily.uk

# ─── Optional: server tuning ───────────────────────────────────────────────
# DATA_DIR defaults to /data inside the container (mounted from ./data on host).
# PORT defaults to 8080.
# DATA_DIR=/data
# PORT=8080

# ─── Litestream → S3 backup ────────────────────────────────────────────────
# Used by the voice-clip-litestream sidecar (docker-compose.prod.yml).
# Filled from 1Password at deploy time — same shared bucket + endpoint as
# valorant-comunity-bot. Each app writes under its own prefix.
# See docs/runbook/litestream-restore.md for the restore procedure.
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_ENDPOINT=
LITESTREAM_S3_ACCESS_KEY_ID=
LITESTREAM_S3_SECRET_ACCESS_KEY=
