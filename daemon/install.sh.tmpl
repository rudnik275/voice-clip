#!/usr/bin/env bash
# voice-clip-daemon installer — run once on the user's Mac:
#   curl -fsSL "https://<server>/install/voice-clip-daemon?token=<DAEMON_TOKEN>" | bash
#
# Drops the daemon source + a launchd plist into ~/.voice-clip-daemon and
# ~/Library/LaunchAgents, registers it with launchctl, and exits.
set -euo pipefail

# Substituted server-side per request.
URL="__URL__"
TOKEN="__TOKEN__"

if [ -z "$URL" ] || [ -z "$TOKEN" ]; then
  echo "voice-clip-daemon: install template not rendered (missing URL/TOKEN)" >&2
  exit 2
fi

DAEMON_DIR="$HOME/.voice-clip-daemon"
PLIST="$HOME/Library/LaunchAgents/com.voiceclip.daemon.plist"
LOG_DIR="$HOME/Library/Logs"

echo "voice-clip-daemon: target = $URL"

# 1. Ensure bun is available (Mac, prefer existing).
if ! command -v bun >/dev/null 2>&1 && [ ! -x "$HOME/.bun/bin/bun" ]; then
  echo "voice-clip-daemon: bun not found; installing into ~/.bun"
  curl -fsSL https://bun.sh/install | bash
fi
BUN_PATH="$(command -v bun || echo "$HOME/.bun/bin/bun")"
if [ ! -x "$BUN_PATH" ]; then
  echo "voice-clip-daemon: bun install failed; aborting" >&2
  exit 3
fi

# 2. Daemon source.
mkdir -p "$DAEMON_DIR" "$LOG_DIR"
cat > "$DAEMON_DIR/index.ts" <<'__VOICE_CLIP_DAEMON_SRC__'
__DAEMON_SOURCE__
__VOICE_CLIP_DAEMON_SRC__
chmod 600 "$DAEMON_DIR/index.ts"

# 3. launchd plist.
cat > "$PLIST" <<__VOICE_CLIP_PLIST__
__PLIST_BODY__
__VOICE_CLIP_PLIST__
chmod 600 "$PLIST"

# 4. (Re)load.
launchctl unload "$PLIST" 2>/dev/null || true
launchctl load "$PLIST"

echo
echo "voice-clip-daemon: installed and started."
echo "  source: $DAEMON_DIR/index.ts"
echo "  plist:  $PLIST"
echo "  logs:   $LOG_DIR/voice-clip-daemon.{out,err}.log"
echo
echo "Test it: запиши голос на телефоне → Cmd+V на этом маке вставит транскрипт."
