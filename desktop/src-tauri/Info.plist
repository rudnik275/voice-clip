<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Registers the voiceclip:// URL scheme so the OS routes the OAuth
       deep-link callback to this app. Tauri merges this into the generated
       Info.plist at bundle time. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.voiceclip.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>voiceclip</string>
      </array>
    </dict>
  </array>
  <!-- Menubar-only app: no Dock icon. The main window is opened explicitly
       from the tray menu or during pairing / settings. -->
  <key>LSUIElement</key>
  <true/>
  <!-- Microphone permission prompt. Required because the bundled PWA
       calls getUserMedia({ audio: true }) inside the webview — macOS
       gates that behind TCC and refuses the request unless this string
       is present in the .app's Info.plist. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Voice Clip records your voice and uploads it to the server for transcription.</string>
</dict>
</plist>
