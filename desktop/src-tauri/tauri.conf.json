{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Clip",
  "version": "0.3.0",
  "identifier": "com.voiceclip.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voice Clip",
        "width": 420,
        "height": 540,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Voice Clip macOS clipboard receiver",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["voiceclip"]
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNEYwRTI3NzJENjU3RTUKUldUbFY5WnlKdzVQb3ZBWEhqV01CZXNhOXptT0w2VzVPWHRjcklhOXBTbThMRHdlaXBXWHpkaVUK",
      "endpoints": [
        "https://voice.rudifamily.uk/desktop/update.json"
      ]
    }
  }
}
