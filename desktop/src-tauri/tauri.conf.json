{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Clip",
  "version": "0.3.6",
  "identifier": "com.voiceclip.desktop",
  "build": {
    "frontendDist": "./dist",
    "beforeBuildCommand": "bun scripts/build-frontend.ts 2>/dev/null || bun ../scripts/build-frontend.ts",
    "beforeDevCommand": "bun scripts/build-frontend.ts 2>/dev/null || bun ../scripts/build-frontend.ts"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voice Clip",
        "width": 420,
        "height": 680,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://voice.rudifamily.uk; media-src 'self' blob:; img-src 'self' data: blob: https:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Voice Clip macOS clipboard receiver",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["voiceclip"]
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNEYwRTI3NzJENjU3RTUKUldUbFY5WnlKdzVQb3ZBWEhqV01CZXNhOXptT0w2VzVPWHRjcklhOXBTbThMRHdlaXBXWHpkaVUK",
      "endpoints": [
        "https://voice.rudifamily.uk/desktop/update.json"
      ]
    }
  }
}
