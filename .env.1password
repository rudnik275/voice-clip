# 1Password references — used by ./scripts/with-secrets.sh (which calls
# `op run --env-file=.env.1password -- <cmd>`). `op run` resolves these
# references at exec time, injects the values into the child process env,
# and masks them in stdout/stderr. Values never touch disk, never appear
# in shell history, never reach the AI's conversation context.
#
# Scope of this file: ONLY the NAS connection. App secrets (OPENAI_API_KEY,
# ADMIN_TOKEN) live in `.env` (plain, gitignored, AI-blocked) per project
# convention.
#
# Sources (vault / item-uuid / field):
#   - 1Password vault: Personal
#   - item: NAS (local) — referenced by UUID because the spaces+parens in the
#     item title break the op:// URI syntax
#   - fields: username (USERNAME), password (CONCEALED)

NAS_USERNAME=op://Personal/yzhfzwcapvdsjpuldo7ekxmctu/username
NAS_PASSWORD=op://Personal/yzhfzwcapvdsjpuldo7ekxmctu/password
