# 1Password env template for scripts/cleanup-cf-tail.sh.
# Resolve at exec time:
#   op run --env-file=.env.cleanup-cf.1password -- ./scripts/cleanup-cf-tail.sh --apply
#
# The op CLI substitutes op:// references inline and masks the values in
# stdout/stderr; the actual token never appears in the AI conversation.

CF_API_TOKEN="op://VoiceClip/cf-token/api-token"
